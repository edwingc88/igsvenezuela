---
import Layout from '../layouts/Layout.astro';


const title = 'Tu Acordes Cristianos'
const description =
  'Encuentra acordes, letras y diagramas para guitarra y piano de tus canciones cristianas favoritas'
const canonical = 'https://www.infolavelada.com/'
---

<Layout title={title} description={description} canonical={canonical}>
        <!-- PÁGINA: SERVICIOS -->
<main id="page-servicios" class="page-content  py-16 px-6">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-5xl font-bold text-orange-900 italic">Nuestros Encuentros</h2>
                <p class="text-gray-500 mt-2 text-lg">Te invitamos a ser parte de lo que Dios está haciendo.</p>
            </div>

            <!-- Grid de Servicios con Imágenes de Fondo -->
            <div class="grid md:grid-cols-3 gap-8">
                
                <!-- Martes -->
                <div class="service-card-img">
                    <img src="https://images.unsplash.com/photo-1544427920-c49ccfb85579?auto=format&fit=crop&q=80&w=800" alt="Alabanza">
                    <div class="service-overlay">
                        <div class="flex items-center gap-2 mb-3 text-orange-400">
                            <i class="fas fa-pray"></i>
                            <span class="text-xs font-bold uppercase tracking-widest">Oración</span>
                        </div>
                        <h3 class="text-3xl font-bold italic mb-2">Intercesión y Alabanza</h3>
                        <p class="text-orange-300 font-bold mb-4">Martes — 6:30 PM</p>
                        <p class="text-gray-200 text-sm leading-relaxed">
                            Un espacio sagrado para levantar nuestras manos y corazones en unidad ante el Padre.
                        </p>
                    </div>
                </div>

                <!-- Jueves -->
                <div class="service-card-img">
                    <img src="https://images.unsplash.com/photo-1507692049790-de58290a4334?auto=format&fit=crop&q=80&w=800" alt="Estudio">
                    <div class="service-overlay">
                        <div class="flex items-center gap-2 mb-3 text-orange-400">
                            <i class="fas fa-fire"></i>
                            <span class="text-xs font-bold uppercase tracking-widest">Manifestación</span>
                        </div>
                        <h3 class="text-3xl font-bold italic mb-2">Fe y Poder</h3>
                        <p class="text-orange-300 font-bold mb-4">Jueves — 6:30 PM</p>
                        <p class="text-gray-200 text-sm leading-relaxed">
                            Ven a recibir una palabra de autoridad que activará tu fe para ver lo imposible.
                        </p>
                    </div>
                </div>

                <!-- Domingo -->
                <div class="service-card-img">
                    <img src="https://images.unsplash.com/photo-1470075801209-17f9ec0cada6?auto=format&fit=crop&q=80&w=800" alt="Familia en Iglesia">
                    <div class="service-overlay">
                        <div class="flex items-center gap-2 mb-3 text-orange-400">
                            <i class="fas fa-sun"></i>
                            <span class="text-xs font-bold uppercase tracking-widest">Celebración</span>
                        </div>
                        <h3 class="text-3xl font-bold italic mb-2">Domingo de Celebración</h3>
                        <p class="text-orange-300 font-bold mb-4">Domingo — 9:00 AM</p>
                        <p class="text-gray-200 text-sm leading-relaxed">
                            Toda la familia reunida para celebrar la victoria de Cristo en un ambiente de amor.
                        </p>
                    </div>
                </div>

            </div>

            <!-- Banner de Evento Especial -->
            <div class="special-event-banner">
                <div class="max-w-2xl">
                    <span class="bg-orange-600 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-widest mb-4 inline-block">Evento Especial</span>
                    <h3 class="text-4xl md:text-5xl font-bold italic mb-6">Congreso "Fuego Santo"</h3>
                    <p class="text-xl text-orange-50/90 mb-8">Un tiempo de avivamiento y renovación espiritual que no te puedes perder.</p>
                    <div class="flex flex-wrap justify-center gap-6 text-sm font-bold uppercase tracking-tighter">
                        <div class="bg-white/10 backdrop-blur-md px-6 py-3 rounded-2xl border border-white/20">
                            <i class="far fa-calendar-alt mr-2"></i> 15 - 17 de Mayo
                        </div>
                        <div class="bg-white/10 backdrop-blur-md px-6 py-3 rounded-2xl border border-white/20">
                            <i class="fas fa-map-marker-alt mr-2"></i> Auditorio Principal
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <style>
           /* Misión y Visión */
        .card-mission {
            background: white;
            border: 1px solid #f1f1f1;
            color: #3d2b1f;
        }
        
        .card-vision {
            background: #8c4b1d;
            color: #fdfaf6;
        }

        /* Estilos de Servicios Corregidos */
        .service-card-img {
            position: relative;
            height: 500px;
            border-radius: 40px;
            overflow: hidden;
            transition: all 0.5s ease;
            cursor: pointer;
            display: flex;
            align-items: flex-end;
            color: white;
        }

        .service-card-img:hover {
            transform: scale(1.02);
            box-shadow: 0 30px 60px -12px rgba(0,0,0,0.4);
        }

        .service-card-img img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            transition: transform 0.5s ease;
        }

        .service-card-img:hover img {
            transform: scale(1.1);
        }

        .service-overlay {
            position: relative;
            z-index: 1;
            width: 100%;
            padding: 40px;
            background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 50%, transparent 100%);
        }

        .special-event-banner {
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&q=80&w=1200');
            background-size: cover;
            background-position: center;
            border-radius: 50px;
            min-height: 450px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 40px;
            color: white;
            box-shadow: 0 30px 60px -15px rgba(0,0,0,0.3);
            margin-top: 4rem;
        }
    </style>
</Layout>
