---
// Componente reutilizable para el formulario de galería
---

<form id="churchForm" class="space-y-3">
    <div class="grid md:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm font-bold text-orange-900 mb-2" for="nombre">Publicado por:</label>
            <input type="text" id="nombre" placeholder="Tu nombre o familia" 
                class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-orange-500 outline-none transition" required>
        </div>
        <div>
            <label class="block text-sm font-bold text-orange-900 mb-2" for="categoria">Categoría</label>
            <select id="categoria" class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-orange-500 outline-none transition bg-white">
                <option>General</option>
                <option>Martes de Intersecion y alabanza</option>
                <option>Jueves de Fe y Poder</option>
                <option>Domingo de Celebracion</option>
                <option>Servicio de Juvenil</option>
                <option>Servicio Especial</option>
            </select>
        </div>
    </div>

    <div>
        <label class="block text-sm font-bold text-orange-900 mb-2" for="titulo">Título de la Galería</label>
        <input type="text" id="titulo" placeholder="Ej: Fotos del Bautizo" 
            class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-orange-500 outline-none transition" required>
    </div>

    <div>
        <label class="block text-sm font-bold text-orange-900 mb-2">Selecciona tus fotos (pueden ser varias)</label>
        <div id="drop-area" class="drop-zone relative rounded-2xl flex flex-col items-center justify-center cursor-pointer overflow-hidden bg-gray-50">
        <input type="file" id="foto" class="hidden" accept="image/jpeg,image/png,image/webp,image/gif" multiple>
            
            <div id="modal-preview-grid" class="flex flex-wrap gap-2 p-4">
                <!-- Aquí se cargarán las miniaturas -->
            </div>

            <div id="modal-preview-info" class="text-center py-6">
                <i class="fas fa-images text-5xl text-orange-200 mb-4"></i>
                <p class="text-gray-400 font-medium px-4">Haz clic para elegir una o varias fotos</p>
            </div>
        </div>
    </div>

    <button type="submit" class="w-full btn-church text-white font-bold py-2.5 md:px-0 px-2 rounded-xl shadow-lg flex items-center justify-center space-x-2 cursor-pointer">
        <span class="text-sm md:text-base">Publicar Galería en el Muro</span>
        <i class="fas fa-th"></i>
    </button>
</form>

<script>
// @ts-nocheck

function initFormularioGaleria() {
// Script para manejar el formulario, preview y modal (si existe)
const modal = document.querySelector('#uploadModal');

const closeModal = () => {
    modal?.classList.remove('active');
    document.body.style.overflow = 'auto';
};

document.querySelector('#btn-subir-fotos')?.addEventListener('click', (e) => {
    e.preventDefault();
    modal?.classList.add('active');
    document.body.style.overflow = 'hidden';
});

document.querySelector('#btn-cerrar-modal')?.addEventListener('click', closeModal);

// --- PREVIEW MODAL ---
const dropArea = document.querySelector('#drop-area') as HTMLElement | null;
const fileInput = document.querySelector('#foto') as HTMLInputElement | null;
const previewGrid = document.querySelector('#modal-preview-grid') as HTMLElement | null;
const previewInfo = document.querySelector('#modal-preview-info') as HTMLElement | null;
let selectedFiles: File[] = [];

// Constantes de validación
const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5MB por archivo
const MAX_FILES = 20; // máximo 20 archivos
const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];

function validateFile(file: File): string | null {
  if (!ALLOWED_TYPES.includes(file.type)) {
    return `Tipo de archivo no permitido: ${file.name}. Solo imágenes JPG, PNG, WebP o GIF.`;
  }
  if (file.size > MAX_FILE_SIZE) {
    return `Archivo demasiado grande: ${file.name}. Máximo 5MB por archivo.`;
  }
  return null;
}

function getClientId() {
  let id = localStorage.getItem('igs_client_id');
  if (!id) {
    id = crypto.randomUUID?.() ?? `igs-${Date.now()}-${Math.random().toString(16).slice(2)}`;
    localStorage.setItem('igs_client_id', id);
  }
  return id;
}

dropArea?.addEventListener('click', () => fileInput?.click());

fileInput?.addEventListener('change', () => {
  const files = fileInput.files;
    if (!files) return;

    // Validar cantidad de archivos
    if (files.length > MAX_FILES) {
        alert(`Máximo ${MAX_FILES} archivos permitidos.`);
        fileInput.value = '';
        return;
    }

    // Validar cada archivo
    const errors: string[] = [];
    for (let i = 0; i < files.length; i++) {
        const error = validateFile(files[i]);
        if (error) errors.push(error);
    }

    if (errors.length > 0) {
        alert('Errores en archivos:\n' + errors.join('\n'));
        fileInput.value = '';
        return;
    }

    selectedFiles = Array.from(files);


    /*     selectedFiles = fileInput.files ? Array.from(fileInput.files) : [];
 */    if (!previewGrid) return;
    previewGrid.innerHTML = '';
    if (selectedFiles.length > 0) {
        previewInfo?.classList.add('hidden');
        selectedFiles.forEach((file) => {
            const reader = new FileReader();
            reader.onload = (ev) => {
                const result = ev.target?.result;
                if (typeof result !== 'string') return;
                const img = document.createElement('img');
                img.src = result;
                img.className = 'preview-thumb';
                img.alt = file.name;
                previewGrid.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    }
});

// --- SUBMIT ---
document.querySelector('#churchForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (selectedFiles.length === 0) return alert('Selecciona fotos.');

    const autor = (document.querySelector('#nombre') as HTMLInputElement | null)?.value ?? '';
    const titulo = (document.querySelector('#titulo') as HTMLInputElement | null)?.value ?? '';
    const categoria = (document.querySelector('#categoria') as HTMLSelectElement | null)?.value ?? '';

    const fd = new FormData();
    fd.append('autor', autor);
    fd.append('titulo', titulo);
    fd.append('categoria', categoria);
    fd.append('client_id', getClientId());
    selectedFiles.forEach((f) => fd.append('files', f));

    const submitButton = document.querySelector('#churchForm button[type="submit"]');
    const originalButtonText = submitButton?.textContent;
    submitButton?.setAttribute('disabled', 'true');
    if (submitButton) submitButton.textContent = 'Subiendo...';

    try {
        const res = await fetch('/api/upload', { method: 'POST', body: fd });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) {
            console.error('[Upload] Error', json);
            alert(json?.error ?? 'Error subiendo galería.');
            return;
        }

        window.dispatchEvent(new CustomEvent('galeria:created', { detail: json?.galeria }));
        closeModal();
    } catch (err) {
        console.error('[Upload] Falló', err);
        alert('Error subiendo galería.');
    } finally {
        if (submitButton) {
            submitButton.removeAttribute('disabled');
            submitButton.textContent = originalButtonText ?? 'Publicar Galería en el Muro';
        }
    }
});

}
document.addEventListener('astro:page-load', initFormularioGaleria);


</script>