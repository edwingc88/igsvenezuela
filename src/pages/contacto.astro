---
import Layout from '../layouts/Layout.astro';


const title = 'Tu Acordes Cristianos'
const description =
  'Encuentra acordes, letras y diagramas para guitarra y piano de tus canciones cristianas favoritas'
const canonical = 'https://www.infolavelada.com/'
---

<Layout title={title} description={description} canonical={canonical}>
       
    <!-- PÁGINA: CONTACTO -->
    <main id="page-contacto" class="page-content  py-20 px-6">
        <div class="max-w-6xl mx-auto">
            
            <div class="text-center mb-16">
                <h2 class="text-5xl font-bold text-orange-900 italic">Queremos conocerte</h2>
                <p class="text-gray-500 mt-4 text-lg">Si deseas visitarnos por primera vez o tienes una petición de oración especial, escríbenos aquí.</p>
            </div>

            <div class="grid lg:grid-cols-12 gap-12 items-start">
                
                <!-- Columna Izquierda: Info -->
                <div class="lg:col-span-4 space-y-6">
                    <div class="info-card-main">
                        <h3 class="text-2xl font-bold mb-6 italic border-b border-white/20 pb-2">Información</h3>
                        <div class="space-y-4">
                            <div class="flex items-start gap-4">
                                <i class="fas fa-map-marker-alt mt-1"></i>
                                <p>Caracas, Venezuela. Cerca del metro.</p>
                            </div>
                            <div class="flex items-center gap-4">
                                <i class="fas fa-phone-alt"></i>
                                <p>+58 (412) 000-00-00</p>
                            </div>
                            <div class="flex items-center gap-4">
                                <i class="fas fa-envelope"></i>
                                <p>info@iglesiajesucristo.ve</p>
                            </div>
                            
                            <!-- NUEVA SECCIÓN: Referencia a Diezmos y Ofrendas -->
                            <div class="pt-4 mt-6 border-t border-white/20">
                                <div class="flex items-center gap-4 text-orange-300">
                                    <i class="fas fa-hand-holding-heart text-2xl"></i>
                                    <div>
                                        <p class="font-bold text-white italic text-lg">Redes Sociales</p>
                                        <p class="text-xs text-orange-100/70 uppercase tracking-tighter">Sigue hacia abajo para datos bancarios</p>
                                    </div>
                                </div>
                                <div class="flex justify-center mt-4">
                                    <i class="fas fa-chevron-down animate-bounce-subtle text-orange-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="office-hours-card text-center">
                        <h4 class="text-xl font-bold text-orange-800 italic mb-2">Horarios de Oficina</h4>
                        <p class="text-gray-500">Lunes a Viernes: 9am - 4pm</p>
                    </div>
                </div>

                <!-- Columna Derecha: Formulario -->
                <div class="lg:col-span-8">
                    <div class="contact-form-container">
                        <form class="space-y-6">
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Asunto</label>
                                <select class="form-input text-gray-600">
                                    <option>Visita por primera vez</option>
                                    <option>Petición de Oración</option>
                                    <option>Información General</option>
                                    <option>Otro motivo</option>
                                </select>
                            </div>
                            <div class="grid md:grid-cols-2 gap-6">
                                <input type="text" placeholder="Tu Nombre" class="form-input">
                                <input type="text" placeholder="WhatsApp / Teléfono" class="form-input">
                            </div>
                            <textarea placeholder="Cuéntanos un poco más..." rows="5" class="form-input resize-none"></textarea>
                            <button type="button" class="w-full py-5 btn-church rounded-2xl font-bold text-lg shadow-xl uppercase tracking-widest">
                                Enviar a Secretaría
                            </button>
                        </form>
                    </div>
                </div>
            </div>


        </div>
    </main>

    <style>
        
        /* Estilos de Contacto e Información */
        .info-card-main {
            background: #a63d05;
            color: white;
            border-radius: 35px;
            padding: 40px;
            box-shadow: 0 15px 30px rgba(166, 61, 5, 0.2);
        }
        
        .office-hours-card {
            background: white;
            border: 1px solid #f1f1f1;
            border-radius: 30px;
            padding: 30px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.03);
        }

        .contact-form-container {
            background: white;
            border-radius: 40px;
            padding: 40px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.05);
        }

        .form-input {
            background-color: #f8f9fa;
            border-radius: 12px;
            padding: 16px;
            width: 100%;
            border: 1px solid transparent;
            transition: all 0.3s ease;
        }
        .form-input:focus {
            border-color: var(--color-secundario);
            background-color: white;
            outline: none;
        }



        /* Animación de flecha */
        @keyframes bounce-subtle {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(5px); }
        }
        .animate-bounce-subtle {
            animation: bounce-subtle 2s infinite;
        }

        </style>
</Layout>
