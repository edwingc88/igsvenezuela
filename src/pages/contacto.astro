---
import Layout from '../layouts/Layout.astro';


const title = 'Tu Acordes Cristianos'
const description =
  'Encuentra acordes, letras y diagramas para guitarra y piano de tus canciones cristianas favoritas'
const canonical = 'https://www.infolavelada.com/'
---

<Layout title={title} description={description} canonical={canonical}>
       
    <!-- PÁGINA: CONTACTO -->
    <main id="page-contacto" class="page-content  pt-12 pb-20 px-6">
   
            
            <div class="w-full max-w-6xl  text-center mb-14">
                <h2 class="text-5xl font-bold text-orange-900 italic">Queremos conocerte</h2>
                <p class="text-gray-500 mt-4 text-lg">Si deseas visitarnos por primera vez o tienes una petición de oración especial, escríbenos aquí.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start w-full max-w-6xl  ">
                
                <!-- Columna Izquierda: Info -->
                <div class="lg:col-span-4 space-y-5">
                    <div class="info-card-main py-9 px-10">
                        <h3 class="text-2xl font-bold mb-4 italic border-b border-white/20 pb-2">Información</h3>
                        <div class="space-y-3">
                            <div class="flex items-start gap-4">
                                <i class="fas fa-map-marker-alt mt-1"></i>
                                <p>Puerto Ordaz, Venezuela. Urb Gran Sabana.</p>
                            </div>
                            <div class="flex items-center gap-4">
                                <i class="fas fa-phone-alt"></i>
                                <p>+58 412-1126733</p>
                            </div>
                            <div class="flex items-center gap-4">
                                <i class="fas fa-envelope"></i>
                                <p>iglesiajesucristovzla7@gmail.com</p>
                            </div>
                                       <!-- NUEVA SECCIÓN: Diezmos y ofrendas-->
                            <div class="bank-details-glass mt-6 pt-5 border-t border-white/20">
                                <div class="flex items-center gap-4 mb-3">
                                    <i class="fas  fa-hand-holding-heart text-1xl text-orange-300"></i>
                                    <h4 class="text-md font-bold italic">Diezmos y Ofrendas</h4>
                                </div>
                                <div class="space-y-4 ml-1 md:ml-8">
                                    <div>
                                        <p class="text-[10px] uppercase tracking-widest opacity-60 mb-1">Datos para deposito o pago movil</p>
                                        <p class="text-sm font-medium">Banco Nacional de Credito</p>
                                    </div>
                                    <div class="flex gap-4 ">

                                    <div>
                                        <p class="text-[10px] uppercase tracking-widest opacity-60 mb-1">RIF / Cédula</p>
                                        <p class="text-sm">V-20.549.250</p>
                                    </div>
                                    <div>
                                        <p class="text-[10px] uppercase tracking-widest opacity-60 mb-1">Telefono </p>
                                        <p class="text-sm">0412-1126733</p>
                                    </div>
                                    </div>
        
                                </div>
                            </div>

                            <!-- NUEVA SECCIÓN: Redes Sociales -->
                            <div class="pt-2.5" >
                                <div class="flex gap-4 text-orange-300">
                                    <i class="fas mt-1 fa-network-wired text-1xl"></i>
                                    <div>
                                        <p class="font-bold text-white italic text-md">Redes Sociales</p>
                                            <div class="flex space-x-4 mt-2">
                                            <a href="#" class="w-8 h-8 rounded-full bg-orange-900 flex items-center justify-center text-white hover:bg-orange-600 transition"><i class="fab fa-facebook-f"></i></a>
                                            <a href="#" class="w-8 h-8 rounded-full bg-orange-900 flex items-center justify-center text-white hover:bg-orange-600 transition"><i class="fab fa-instagram"></i></a>
                                            <a href="#" class="w-8 h-8 rounded-full bg-orange-900 flex items-center justify-center text-white hover:bg-orange-600 transition"><i class="fab fa-youtube"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Formulario -->
                <div class="lg:col-span-8">
                    <div class="contact-form-container">
                        <form class="space-y-6">
                            <div>
                                <label class="block text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2 ml-1">Asunto</label>
                                <select class="form-input text-gray-600">
                                    <option>Visita por primera vez</option>
                                    <option>Petición de Oración</option>
                                    <option>Información General</option>
                                    <option>Otro motivo</option>
                                </select>
                            </div>
                            <div class="grid md:grid-cols-2 gap-6">
                                <input type="text" placeholder="Tu Nombre" class="form-input">
                                <input type="text" placeholder="WhatsApp / Teléfono" class="form-input">
                            </div>
                            <textarea placeholder="Cuéntanos un poco más..." rows="5" class="form-input resize-none"></textarea>
                            <button type="button" class="w-full py-4 btn-church rounded-2xl font-bold text-lg shadow-xl uppercase tracking-widest cursor-pointer ">
                                Enviar a Mensaje
                            </button>
                        </form>
                    </div>

                </div>
            </div>

    </main>

    <style>
        
        /* Estilos de Contacto e Información */
        .info-card-main {
            background: #a63d05;
            color: white;
            border-radius: 35px;
            box-shadow: 0 15px 30px rgba(166, 61, 5, 0.2);
        }
        
        .office-hours-card {
            background: white;
            border: 1px solid #f1f1f1;
            border-radius: 30px;
            padding: 30px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.03);
        }

        .contact-form-container {
            background: white;
            border-radius: 40px;
            padding: 40px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.05);
        }

        .form-input {
            background-color: #f8f9fa;
            border-radius: 12px;
            padding: 16px;
            width: 100%;
            border: 1px solid transparent;
            transition: all 0.3s ease;
        }
        .form-input:focus {
            border-color: var(--color-secundario);
            background-color: white;
            outline: none;
        }



        /* Animación de flecha */
        @keyframes bounce-subtle {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(5px); }
        }
        .animate-bounce-subtle {
            animation: bounce-subtle 2s infinite;
        }

        </style>
</Layout>
