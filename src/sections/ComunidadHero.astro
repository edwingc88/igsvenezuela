---

/* const response = await fetch(new URL('/api/galerias', Astro.url));
const galerias = await response.json(); */
// @ts-ignore
import { getGalerias } from '../lib/cloudinary.js';
import FormularioGaleria from '../components/FormularioGaleria.astro';

const galerias = await getGalerias();

---

<!-- Bridge servidor → cliente -->
<script id="galeria-data" type="application/json" set:html={JSON.stringify(galerias)}></script>

<!-- Modal Formulario -->
<div id="uploadModal" class="modal-overlay fixed inset-0 z-60 hidden items-center justify-center p-6">
    <div class="bg-white w-full max-w-2xl rounded-4xl shadow-2xl relative max-h-[95vh] overflow-y-auto">
        <button id="btn-cerrar-modal" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-600 hover:text-gray-800 transition rounded-full">
            <i class="fas fa-times"></i>
        </button>
        <div class="p-4 md:p-6">
            <h2 class="text-2xl font-bold text-orange-900 mb-1">Compartir Galería</h2>
            <p class="text-sm text-gray-500 mb-4">Sube tus fotos para que toda la congregación pueda verlas.</p>
            <FormularioGaleria />
        </div>
    </div>
</div>

<!-- PÁGINA: COMUNIDAD -->
<main id="page-comunidad" class="page-content py-20 px-6">
    <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-orange-900 italic">Muro de Comunidad</h2>
            <p class="text-gray-500 mt-2 pb-4">Momentos capturados por nuestra familia.</p>
            <a href="#" id="btn-subir-fotos" class="btn-church px-6 py-2 rounded-full shadow-lg hover:bg-orange-600 hover:translate-y-0.5 transition cursor-pointer">
                Subir Fotos
            </a>
        </div>

        <!-- Galería renderizada por JS -->
        <div id="posts-container" class="space-y-16"></div>

        <!-- Paginación -->
        <div class="mt-20 flex justify-center items-center space-x-3">
            <button class="w-12 h-12 rounded-2xl border border-orange-100 flex items-center justify-center text-orange-900 hover:bg-orange-50 transition">&#8249;</button>
            <button class="w-12 h-12 rounded-2xl bg-orange-800 text-white font-bold">1</button>
            <button class="w-12 h-12 rounded-2xl border border-orange-100 flex items-center justify-center text-orange-900 hover:bg-orange-50 transition font-bold">2</button>
            <button class="w-12 h-12 rounded-2xl border border-orange-100 flex items-center justify-center text-orange-900 hover:bg-orange-50 transition">&#8250;</button>
        </div>
    </div>
</main>


<style is:global>
    .gallery-content { width: 100%; }

    .internal-bento {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 110px;
        gap: 6px;
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
    }
    .internal-bento img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 6px;
        transition: transform 0.3s;
        display: block;
    }
    .internal-bento img:hover { transform: scale(1.03); }

    .view-slider { width: 100%; display: block; }
    .swiper { width: 100% !important; height: 420px; border-radius: 16px; overflow: hidden; }
    .swiper-wrapper { width: 100% !important; }
    .swiper-slide { width: 100% !important; height: 100%; }
    .swiper-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .swiper-button-next,
    .swiper-button-prev {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        border-radius: 9999px;
        background: rgba(248, 113, 20, 0.95);
        color: white;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.35);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    }
    .swiper-button-next { right: 12px; }
    .swiper-button-prev { left: 12px; }
    .swiper-button-next:hover,
    .swiper-button-prev:hover {
        background: rgba(255, 159, 67, 0.95);
    }
    .swiper-button-next::after,
    .swiper-button-prev::after {
        display: none;
    }

    .swiper-navigation-icon-text {
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
        pointer-events: none;
    }

    .modal-overlay {
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    display: none;  /* oculto por defecto */
}
.modal-overlay.active {
    display: flex;  /* visible cuando tiene clase active */
}

    .drop-zone { border: 2px dashed #d1d5db; min-height: 150px; border-radius: 15px; }
    .preview-thumb { width: 60px; height: 60px; object-fit: cover; border-radius: 8px; }
</style>


<script>
// @ts-nocheck
import Swiper from 'swiper';
import { Navigation } from 'swiper/modules';
import 'swiper/css';
import 'swiper/css/navigation';

let galerias = JSON.parse(
    document.getElementById('galeria-data').textContent
);

const swiperInstances = new Map();

function renderGalerias() {
    const container = document.querySelector('#posts-container');
    if (!container) return;

    container.innerHTML = galerias.map(g => `
        <article class="bg-white p-8 rounded-[40px] shadow-xl border border-orange-50 relative" data-id="${g.id}">
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
                <div>
                    <span class="text-[10px] font-bold ${g.categoriaColor} px-3 py-1 rounded-full uppercase tracking-widest">${g.categoria}</span>
                    <h3 class="text-2xl font-bold text-orange-900 mt-2">${g.titulo}</h3>
                    <p class="text-sm text-gray-400 mt-1">Publicado por <b>${g.autor}</b> • ${g.fecha}</p>
                </div>
                <div class="flex items-center gap-3">
                    <button class="btn-download text-xs font-bold px-4 py-2 rounded-xl border border-orange-200 text-orange-800 hover:bg-orange-50 transition cursor-pointer">
                        ⬇ Descargar todo
                    </button>
                    <div class="flex bg-gray-100 p-1 rounded-xl">
                        <button data-view="bento" class="btn-toggle px-4 py-2 rounded-lg text-xs font-bold transition bg-white shadow-sm text-orange-900 hover:bg-gray-200 cursor-pointer">Bento</button>
                        <button data-view="slider" class="btn-toggle px-4 py-2 rounded-lg text-xs font-bold transition text-gray-500 hover:bg-gray-200 cursor-pointer">Slider</button>
                    </div>
                </div>
            </div>
            <div class="gallery-content">
                <div class="view-bento internal-bento">
                    ${g.imagenes.map((src, i) => `<img src="${src}" alt="foto ${i + 1}">`).join('')}
                </div>
                <div class="view-slider" style="display:none">
                    <div class="swiper" id="swiper-${g.id}">
                        <div class="swiper-wrapper">
                            ${g.imagenes.map((src, i) => `<div class="swiper-slide"><img src="${src}" alt="foto ${i + 1}"></div>`).join('')}
                        </div>
                        <button type="button" class="swiper-button-next" aria-label="Siguiente">
                            <span class="swiper-navigation-icon-text">›</span>
                        </button>
                        <button type="button" class="swiper-button-prev" aria-label="Anterior">
                            <span class="swiper-navigation-icon-text">‹</span>
                        </button>
                    </div>
                </div>
            </div>
        </article>
    `).join('');

    bindToggleEvents();
    bindDownloadEvents();
}

function initSwiper(id) {
    const key = `swiper-${id}`;
    console.log('[Swiper] inicializando', key);
    const container = document.querySelector(`#${key}`);
    if (!container) {
        console.warn('[Swiper] contenedor no encontrado', key);
        return;
    }

    const slideCount = container.querySelectorAll('.swiper-slide').length;
    console.log('[Swiper] slides encontradas', slideCount, 'para', key);

    // Destruir instancia previa si existe
    if (swiperInstances.has(key)) {
        swiperInstances.get(key).destroy(true, true);
        swiperInstances.delete(key);
    }

    const nextEl = container.querySelector('.swiper-button-next');
    const prevEl = container.querySelector('.swiper-button-prev');
    console.log('[Swiper] nextEl', nextEl, 'prevEl', prevEl);

    if (nextEl) {
        nextEl.addEventListener('click', () => console.log('[Swiper] boton next clic')); 
    }
    if (prevEl) {
        prevEl.addEventListener('click', () => console.log('[Swiper] boton prev clic')); 
    }

    const instance = new Swiper(container, {
        modules: [Navigation],
        loop: false,
        slidesPerView: 1,
        spaceBetween: 16,
        navigation: {
            nextEl,
            prevEl,
            disabledClass: 'swiper-button-disabled',
            hiddenClass: 'swiper-button-hidden',
        },
        uniqueNavElements: false,
        watchOverflow: true,
        observer: true,
        observeParents: true,
        on: {
            init() {
                this.update();
            },
        },
    });

    instance.update();
    swiperInstances.set(key, instance);
}

function bindToggleEvents() {
    document.querySelectorAll('.btn-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
            const viewType = btn.getAttribute('data-view');
            const article = btn.closest('article');
            const id = article?.getAttribute('data-id');
            const toggleContainer = btn.closest('div');

            toggleContainer?.querySelectorAll('.btn-toggle').forEach(b => {
                b.classList.remove('bg-white', 'shadow-sm', 'text-orange-900');
                b.classList.add('text-gray-500');
            });
            btn.classList.add('bg-white', 'shadow-sm', 'text-orange-900');
            btn.classList.remove('text-gray-500');

            const bentoView = article?.querySelector('.view-bento');
            const sliderView = article?.querySelector('.view-slider');

            if (viewType === 'bento') {
                if (bentoView) bentoView.style.display = 'grid';
                if (sliderView) sliderView.style.display = 'none';
            } else {
                if (bentoView) bentoView.style.display = 'none';
                if (sliderView) sliderView.style.display = 'block';
                setTimeout(() => {
                    console.log('[Swiper] mostrar slider', id);
                    initSwiper(id);
                    const instance = swiperInstances.get(`swiper-${id}`);
                    if (instance) {
                        instance.update();
                    }
                }, 100);
            }
        });
    });
}

function bindDownloadEvents() {
    document.querySelectorAll('.btn-download').forEach(btn => {
        btn.addEventListener('click', () => {
            const article = btn.closest('article');
            article?.querySelectorAll('.view-bento img').forEach((img, i) => {
                const a = document.createElement('a');
                a.href = img.src;
                a.download = `foto-${i + 1}.jpg`;
                a.target = '_blank';
                a.click();
            });
        });
    });
}

renderGalerias();
</script>
