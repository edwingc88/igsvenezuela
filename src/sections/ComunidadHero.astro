---

/* const response = await fetch(new URL('/api/galerias', Astro.url));
const galerias = await response.json(); */
// @ts-ignore
import { getGalerias } from '../lib/cloudinary.js';
import FormularioGaleria from '../components/FormularioGaleria.astro';

const galerias = await getGalerias();

---

<!-- Bridge servidor → cliente -->
<script id="galeria-data" type="application/json" set:html={JSON.stringify(galerias)}></script>

<!-- Modal Formulario -->
<div id="uploadModal" class="modal-overlay fixed inset-0 z-60 hidden items-center justify-center p-6">
    <div class="bg-white w-full max-w-2xl rounded-4xl shadow-2xl relative max-h-[95vh] overflow-y-auto">
        <button id="btn-cerrar-modal" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-600 hover:text-gray-800 transition rounded-full">
            <i class="fas fa-times"></i>
        </button>
        <div class="p-4 md:p-6">
            <h2 class="text-2xl font-bold text-orange-900 mb-1">Compartir Galería</h2>
            <p class="text-sm text-gray-500 mb-4">Sube tus fotos para que toda la congregación pueda verlas.</p>
            <FormularioGaleria />
        </div>
    </div>
</div>

<!-- PÁGINA: COMUNIDAD -->
<main id="page-comunidad" class="page-content pt-12 pb-20 px-6">
    <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-orange-900 italic">Muro de Comunidad</h2>
            <p class="text-gray-500 mt-2 pb-4">Momentos capturados por nuestra familia.</p>
            <a href="#" id="btn-subir-fotos" class="btn-church px-6 py-2 rounded-full shadow-lg hover:bg-orange-600 hover:translate-y-0.5 transition cursor-pointer">
                Subir Fotos
            </a>
        </div>

        <!-- Galería renderizada por JS -->
        <div id="posts-container" class="space-y-16"></div>

        <!-- Paginación -->
        <div class="mt-20 flex justify-center items-center space-x-3">
            <button class="w-12 h-12 rounded-2xl border border-orange-100 flex items-center justify-center text-orange-900 hover:bg-orange-50 transition">&#8249;</button>
            <button class="w-12 h-12 rounded-2xl bg-orange-800 text-white font-bold">1</button>
            <button class="w-12 h-12 rounded-2xl border border-orange-100 flex items-center justify-center text-orange-900 hover:bg-orange-50 transition font-bold">2</button>
            <button class="w-12 h-12 rounded-2xl border border-orange-100 flex items-center justify-center text-orange-900 hover:bg-orange-50 transition">&#8250;</button>
        </div>
    </div>
</main>


<style is:global>
    .gallery-content { width: 100%; }

    .internal-bento {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 140px;
        gap: 6px;
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
    }
    /* En modo bento, NO recortamos: mostramos completa y rellenamos con fondo. */
    .internal-bento { background: rgba(29, 26, 25, 0.041); }

/* Cuando la pantalla sea menor a 600px (puedes ajustar este valor) */
@media (max-width: 600px) {
    .internal-bento {
        grid-template-columns: 1fr; /* Una sola columna */
        grid-auto-rows: auto;      /* Opcional: permite que las celdas crezcan según su contenido */
    }
}

    .img-download-wrap {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 6px;
        overflow: hidden;
        background:
          radial-gradient(700px 220px at 50% 35%, rgba(255, 255, 255, 0.055), rgba(5, 8, 17, 0) 60%),
          rgba(2, 3, 7, 0.829);
    }
    .img-download-wrap img {
        width: 100%;
        height: 100%;
        object-fit: contain; /* completa, sin recorte */
        transition: transform 0.25s ease;
        display: block;
    }
    .img-download-wrap:hover img { transform: scale(1.01); }
    .img-download-btn {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(6px);
        text-decoration: none;
        opacity: 0;
        transform: translateY(-2px);
        transition: opacity 160ms ease, transform 160ms ease, background 160ms ease;
        z-index: 5;
    }
    .img-download-wrap:hover .img-download-btn,
    .swiper-slide:hover .img-download-btn {
        opacity: 1;
        transform: translateY(0);
    }
    .img-download-btn:hover {
        background: rgba(0, 0, 0, 0.5);
    }

    .view-slider { width: 100%; display: block; }
    .swiper {
        width: 100% !important;
        height: auto;
        min-height: 360px;
        max-height: min(72vh, 560px);
        border-radius: 16px;
        overflow: hidden;
        /* Swiper usa estas variables (default azul). Forzamos blanco. */
        --swiper-theme-color: rgba(255, 255, 255, 0.92);
        --swiper-navigation-color: rgba(255, 255, 255, 0.92);
    }
    .swiper-wrapper { width: 100% !important; }
    .swiper-slide {
        width: 100% !important;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        background:
          radial-gradient(1200px 500px at 50% 40%, rgba(255,255,255,0.06), rgba(10,16,36,0.0) 60%),
          rgba(10, 16, 36, 0.22);
    }
    .swiper-slide .img-download-wrap {
        width: 100%;
        height: 100%;
        min-height: 420px;
        max-height: min(78vh, 640px);
        position: relative;
    }
    .swiper-slide .img-download-wrap img {
        width: 100%;
        height: 100%;
        object-fit: contain; /* igual que bento: completa sin recorte */
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
    }

    .swiper-button-next,
    .swiper-button-prev {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        border-radius: 9999px;
        background: rgba(10, 16, 36, 0.55);
        color: rgba(255, 255, 255, 0.92) !important;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: background 160ms ease, transform 160ms ease, opacity 160ms ease;
    }
    .swiper-button-next { right: 12px; }
    .swiper-button-prev { left: 12px; }
    .swiper-button-next:hover,
    .swiper-button-prev:hover {
        background: rgba(10, 16, 36, 0.72);
        transform: translateY(-50%) scale(1.03);
    }
    .swiper-button-next::after,
    .swiper-button-prev::after {
        display: none;
    }

    .swiper-navigation-icon-text {
        width: 18px;
        height: 18px;
        pointer-events: none;
        display: block;
    }
    .swiper-navigation-icon-text svg {
        width: 100%;
        height: 100%;
        display: block;
        stroke: currentColor;
        stroke-width: 2.5;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .modal-overlay {
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    display: none;  /* oculto por defecto */
}
.modal-overlay.active {
    display: flex;  /* visible cuando tiene clase active */
}

    .drop-zone { border: 2px dashed #d1d5db; min-height: 150px; border-radius: 15px; }
    .preview-thumb { width: 60px; height: 60px; object-fit: cover; border-radius: 8px; }
</style>


<script>
// @ts-nocheck
import Swiper from 'swiper';
import { Navigation } from 'swiper/modules';
import 'swiper/css';
import 'swiper/css/navigation';
const swiperInstances = new Map();
let galerias = [];
function toCloudinaryDownloadUrl(src) {
    // Fuerza descarga del original vía "fl_attachment" (sin transformaciones).
    // Ej: .../image/upload/...  -> .../image/upload/fl_attachment/...
    return typeof src === 'string' ? src.replace('/upload/', '/upload/fl_attachment/') : src;
}
function renderGalerias() {
    const container = document.querySelector('#posts-container');
    if (!container) return;

    container.innerHTML = galerias.map(g => `
        <article class="bg-white p-8 rounded-[40px] shadow-xl border border-orange-50 relative" data-id="${g.id}">
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
                <div>
                    <span class="text-[10px] font-bold ${g.categoriaColor} px-3 py-1 rounded-full uppercase tracking-widest">${g.categoria}</span>
                    <h3 class="text-2xl font-bold text-orange-900 mt-2">${g.titulo}</h3>
                    <p class="text-sm text-orange-800/70 mt-1">Publicado por <b>${g.autor}</b> • ${g.fecha}</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex bg-gray-100 p-1 rounded-xl">
                        <button data-view="bento" class="btn-toggle px-4 py-2 rounded-lg text-xs font-bold transition bg-white shadow-sm text-orange-900 hover:bg-gray-200 cursor-pointer">Bento</button>
                        <button data-view="slider" class="btn-toggle px-4 py-2 rounded-lg text-xs font-bold transition text-gray-500 hover:bg-gray-200 cursor-pointer">Slider</button>
                    </div>
                </div>
            </div>
            <div class="gallery-content">
                <div class="view-bento internal-bento">
                    ${g.imagenes.map((src, i) => `
                        <div class="img-download-wrap" data-idx="${i}">
                            <img src="${src}" alt="foto ${i + 1}">
                            <a class="img-download-btn" href="${toCloudinaryDownloadUrl(src)}" target="_blank" rel="noopener" aria-label="Descargar imagen ${i + 1}">
                                ⬇
                            </a>
                        </div>
                    `).join('')}
                </div>
                <div class="view-slider" style="display:none">
                    <div class="swiper" id="swiper-${g.id}">
                        <div class="swiper-wrapper">
                            ${g.imagenes.map((src, i) => `
                                <div class="swiper-slide">
                                    <div class="img-download-wrap">
                                        <img src="${src}" alt="foto ${i + 1}">
                                        <a class="img-download-btn" href="${toCloudinaryDownloadUrl(src)}" target="_blank" rel="noopener" aria-label="Descargar imagen ${i + 1}">
                                            ⬇
                                        </a>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                        <button type="button" class="swiper-button-next" aria-label="Siguiente">
                            <span class="swiper-navigation-icon-text" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
                            </span>
                        </button>
                        <button type="button" class="swiper-button-prev" aria-label="Anterior">
                            <span class="swiper-navigation-icon-text" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg>
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </article>
    `).join('');

    bindToggleEvents();
    bindBentoToSliderEvents();
}

function initSwiper(id) {
    const key = `swiper-${id}`;
    console.log('[Swiper] inicializando', key);
    const container = document.querySelector(`#${key}`);
    if (!container) {
        console.warn('[Swiper] contenedor no encontrado', key);
        return;
    }

    const slideCount = container.querySelectorAll('.swiper-slide').length;
    console.log('[Swiper] slides encontradas', slideCount, 'para', key);

    // Destruir instancia previa si existe
    if (swiperInstances.has(key)) {
        swiperInstances.get(key).destroy(true, true);
        swiperInstances.delete(key);
    }

    const nextEl = container.querySelector('.swiper-button-next');
    const prevEl = container.querySelector('.swiper-button-prev');
    console.log('[Swiper] nextEl', nextEl, 'prevEl', prevEl);

    if (nextEl) {
        nextEl.addEventListener('click', () => console.log('[Swiper] boton next clic')); 
    }
    if (prevEl) {
        prevEl.addEventListener('click', () => console.log('[Swiper] boton prev clic')); 
    }

    const instance = new Swiper(container, {
        modules: [Navigation],
        loop: false,
        slidesPerView: 1,
        spaceBetween: 16,
        autoHeight: true,
        preloadImages: true,
        navigation: {
            nextEl,
            prevEl,
            disabledClass: 'swiper-button-disabled',
            hiddenClass: 'swiper-button-hidden',
        },
        uniqueNavElements: false,
        watchOverflow: true,
        observer: true,
        observeParents: true,
        on: {
            init() {
                this.update();
            },
            imagesReady() {
                this.updateAutoHeight(250);
            },
        },
    });

    instance.update();
    swiperInstances.set(key, instance);
}

function bindToggleEvents() {
    document.querySelectorAll('.btn-toggle').forEach(btn => {
        if (btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
            const viewType = btn.getAttribute('data-view');
            const article = btn.closest('article');
            const id = article?.getAttribute('data-id');
            const toggleContainer = btn.closest('div');

            toggleContainer?.querySelectorAll('.btn-toggle').forEach(b => {
                b.classList.remove('bg-white', 'shadow-sm', 'text-orange-900');
                b.classList.add('text-gray-500');
            });
            btn.classList.add('bg-white', 'shadow-sm', 'text-orange-900');
            btn.classList.remove('text-gray-500');

            const bentoView = article?.querySelector('.view-bento');
            const sliderView = article?.querySelector('.view-slider');

            if (viewType === 'bento') {
                if (bentoView) bentoView.style.display = 'grid';
                if (sliderView) sliderView.style.display = 'none';
            } else {
                if (bentoView) bentoView.style.display = 'none';
                if (sliderView) sliderView.style.display = 'block';
                setTimeout(() => {
                    console.log('[Swiper] mostrar slider', id);
                    initSwiper(id);
                    const instance = swiperInstances.get(`swiper-${id}`);
                    if (instance) {
                        const startIdxRaw = article?.getAttribute('data-start-idx');
                        if (startIdxRaw != null) {
                            const startIdx = Number(startIdxRaw);
                            if (Number.isFinite(startIdx)) {
                                instance.slideTo(startIdx, 0);
                            }
                            article?.removeAttribute('data-start-idx');
                        }
                        instance.update();
                    }
                }, 100);
            }
        });
    });
}

function bindBentoToSliderEvents() {
    const container = document.querySelector('#posts-container');
    if (!container) return;
    if (container.dataset.bentoBound === '1') return;
    container.dataset.bentoBound = '1';

    container.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof HTMLElement)) return;

        // Si el click fue en el botón de descargar, no cambiamos de vista.
        if (target.closest('.img-download-btn')) return;

        const wrap = target.closest('.view-bento .img-download-wrap');
        if (!wrap) return;

        const article = wrap.closest('article');
        const idxRaw = wrap.getAttribute('data-idx');
        const idx = idxRaw != null ? Number(idxRaw) : NaN;
        if (!article || !Number.isFinite(idx)) return;

        // Guardamos el índice para que el handler del toggle navegue a esa slide.
        article.setAttribute('data-start-idx', String(idx));

        // Cambiar a slider como si el usuario tocara el botón.
        const sliderBtn = article.querySelector('.btn-toggle[data-view="slider"]');
        sliderBtn?.dispatchEvent(new MouseEvent('click', { bubbles: true }));
    });
}

async function loadGalerias() {
  const el = document.getElementById('galeria-data');
  if (el?.textContent) {
    try {
      galerias = JSON.parse(el.textContent);
      return;
    } catch (_) {
      // fallback: API
    }
  }

  const res = await fetch('/api/galerias');
  if (!res.ok) throw new Error('No se pudo cargar /api/galerias');
  galerias = await res.json();
}

function initComunidad() {
  loadGalerias()
    .then(() => renderGalerias())
    .catch((e) => console.error('[Comunidad] Error cargando galerías', e));
}

document.addEventListener('astro:page-load', initComunidad);

window.addEventListener('galeria:created', () => {
  initComunidad();
});

</script>
