<style>
    .menu{
  cursor: pointer;

  & .linea-1{
    position: relative;
    background-color: #7e2a0c;
    width: 26px;
    height:3px;
    border-radius: 2px;
    margin-block: .4em;
    pointer-events: none; 
    transform: translateY(0) 
  }
  & .linea-2{
    position: relative;
    background-color:  #7e2a0c;
    width: 26px;
    height: 3px;
    border-radius: 2px;
    transition:  transform .6s ;
    transform: scale(1);
    pointer-events: none; 
    transform: translateY(0) 
  }
  & .linea-3{
    transform: translateY(0) 
    position: relative;
    background-color:  #7e2a0c;
    width: 26px;
    height: 3px;
    border-radius: 2px;
    margin-block: .4em;
    pointer-events: none; 
  }
}

.down{
  animation: miAnimacion1 .8s forwards !important;;
}

.down-reverse{
  animation: miAnimacion1R .8s forwards !important;;
}


.up{
  animation: miAnimacion2 .8s forwards !important;;
}

.up-reverse{
  animation: miAnimacion2R .8s forwards !important;;
}


.middle{
  transform: scale(0)!important;
}

.middle-reverse{
  transition:  transform .6s .2s!important ;
  transform: revert;
}


@keyframes miAnimacion1 {
  0% { transform: translateY(0)  }
  50% { transform: translateY(7px) ; }
  100% { transform:  translateY(7px) rotate(45deg) ; }
}

@keyframes miAnimacion2 {
  0% { transform: translateY(0) ; }
  50% { transform: translateY(-12px) ; }
  100% { transform: translateY(-12px)  rotate(135deg) ; }
}


@keyframes miAnimacion1R {
  100% { transform: translateY(0)  }
  50% { transform: translateY(12px) ; }
  0% { transform:  translateY(12px) rotate(45deg) ; }
}

@keyframes miAnimacion2R {
  100% { transform: translateY(0) ; }
  50% { transform: translateY(-12px) ; }
  0% { transform: translateY(-12px)  rotate(135deg) ; }
}

</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector('#mobile-menu-button');
    const menu = document.querySelector('#mobile-menu');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        menu.classList.toggle('flex');
      });
    }

const $= (e)=> document.querySelector(e)

/* document.querySelectorAll('.menu > div').forEach(function(child) {
  child.addEventListener('click', function(event) {
      console.log('Click en un hijo');
  });
}); */


$('.menu').addEventListener('click', (e)=>{
  console.log(e.target.classList)
    if(e.target.classList.contains('close')){
      e.target.classList.remove('close')
      e.target.classList.add('open')
      $('.linea-1').classList.remove('down-reverse')
      $('.linea-2').classList.remove('middle-reverse')
      $('.linea-3').classList.remove('up-reverse')
    $('.linea-1').classList.add('down')
    $('.linea-2').classList.add('middle')
    $('.linea-3').classList.add('up')
    }else{
      e.target.classList.remove('open')
      e.target.classList.add('close')
      $('.linea-1').classList.remove('down')
      $('.linea-2').classList.remove('middle')
      $('.linea-3').classList.remove('up')
      $('.linea-1').classList.add('down-reverse')
      $('.linea-2').classList.add('middle-reverse')
      $('.linea-3').classList.add('up-reverse')
    }
})



  });
</script>



