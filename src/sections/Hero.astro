---
import FormularioGaleria from '../components/FormularioGaleria.astro';
---

    <!-- PÁGINA: INICIO -->
    <main id="page-inicio" class="page-content">
        <!-- Hero Section -->
        <header class="bg-logo relative overflow-hidden bg-church-gradient text-white py-32 md:py-40 px-6 text-center">
            <div class="max-w-4xl mx-auto relative z-10">
                <h1 class="text-4xl md:text-6xl font-bold mb-6 italic">Te esperamos con los brazos abiertos</h1>
                <p class="text-lg md:text-xl opacity-90 mb-10 leading-relaxed text-pretty">
                 "Bienvenido a nuestra iglesia, estamos listos para acompañarte. Si buscas donde congregarte o apoyo a través de la oración, en nuestra casa siempre tendrás un espacio. Visítanos y permítenos conocerte."
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                <a 
                    href="/contacto" 
                    class="inline-block bg-white text-orange-900 px-8 py-4 rounded-xl font-bold shadow-xl hover:bg-orange-50 transition transform hover:scale-105 cursor-pointer"
                >
                    <i class="fas fa-praying-hands mr-2"></i> Quiero que oren por mí 
                </a>
                <a 
                    href="/servicios" 
                    class="inline-block bg-orange-700/30 backdrop-blur-md border border-white/30 text-white px-8 py-4 rounded-xl font-bold hover:bg-orange-700/50 transition hover:scale-105 cursor-pointer"
                >
                    Ver horarios de Servicios
                </a>
                </div>
            </div>
        </header>
        <!-- Mensaje del Pastor / Invitación a la Salvación -->
        <section class="pastor-section py-12 px-6 border-y border-orange-100">
            <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
                <div class="relative">
                <div class="absolute -top-4 -left-4 w-24 h-24 bg-orange-100 rounded-full -z-10"></div>
                
                   <img src="carlos-carlida.jpg" class="rounded-3xl shadow-2xl border-4 border-white transform -rotate-2 hover:rotate-0 transition duration-500 max-w-sm md:max-w-md w-full ml-auto">

                   <div class="absolute bottom-6 right-6 bg-white px-6 py-2 rounded-full shadow-lg border border-orange-50">
                            <p class="text-orange-900 font-bold italic">Pr. Carlos y Carlida de Baez</p>
                    </div>
                </div>
                <div class="space-y-6">
                    <h2 class="text-3xl md:text-4xl font-bold text-orange-900 italic">"Hay un lugar para ti en la mesa del Señor"</h2>
                    <p class="text-lg text-gray-700 leading-relaxed">
                        Querido amigo, no importa por lo que estés pasando o cuán lejos te sientas de Dios, hoy Su amor te busca. Cristo no solo quiere ser tu religión, Él quiere ser tu Salvador, tu paz y tu esperanza firme.
                    </p>
                    <p class="text-lg text-gray-700 leading-relaxed">
                        Venezuela es tierra de bendición, y tú eres parte fundamental de ese propósito. Te invito a que hoy des el paso más importante de tu vida: abrirle tu corazón al Rey de Reyes.
                    </p>
                    <div class="pt-4">
                        <button onclick="showPage('contacto')" class="inline-flex items-baseline md:items-center md:space-x-3 text-orange-800 font-bold text-lg md:text-xl hover:text-orange-600 transition cursor-pointer">
                            <a href="/contacto" >¿Hablamos? Queremos orar contigo</a>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>



        <!-- Formulario de Galería de Fotos -->
        <section id="seccion-subir" class="py-14  md:py-20 px-6 bg-linear-to-b from-orange-50/50 to-bg-orange-100 ">
            <div class="max-w-5xl mx-auto">

                <div class="mx-auto grid md:grid-cols-2 gap-2 items-center">

                  <div>
                    <h2 class="text-3xl md:text-4xl font-bold text-orange-900 italic">¿Quienes Somos?</h2>

                              <p class="text-lg text-gray-700 leading-relaxed pt-4">
                Somos, ante todo, una familia de fe unida por el amor de Dios y el deseo de servirle.  Creemos que no fuimos llamados a caminar solos, sino a ser una comunidad donde cada persona cuenta.
                    </p>
                    <p class="text-lg text-gray-700 leading-relaxed pt-4">
                         Queremos invitarte a conocer nuestra historia, nuestra mision y la visión que nos impulsa a ser un refugio de fe para cada familia en Venezuela.
                    </p>

 
        
                    <div class="pt-4">
                        <button class="inline-flex items-center space-x-3 text-orange-800 font-bold text-xl hover:text-orange-600 transition cursor-pointer">
                            <a href="/nosotros" >Saber más de nosotros</a>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                  </div>

                          <img src="foto-palabra-3.jpg" class="rounded-3xl shadow-2xl border-4 border-white transform rotate-2 hover:rotate-0 transition duration-500 max-w-sm md:max-w-md  mt-6 md:mt-0 w-full ml-auto">

      <!--             <div class="rotate-2 hover:rotate-0 transition duration-500 w-full "    >
                    <img src="foto-palabra-3.jpg" alt="Galería de Fotos" class="rounded-3xl shadow-2xl border-4 border-white w-3xl   ">
                  </div> -->

                </div>
            </div>
        </section>



                <!-- Sección de Diezmos y Ofrendas (Ubicación final) -->
            <section id="giving-section" class="giving-banner py-14 px-10 md:max-w-5xl items-center md:mx-auto mx-4">
                <div class="grid lg:grid-cols-2 gap-16 items-center md:px-6  w-full">
                    <div class="">
                        <h3 class="text-4xl md:text-5xl font-bold italic mb-6">Sé parte de la obra de Dios</h3>
                        <p class="text-lg text-orange-100/90 mb-8 leading-relaxed">
                            Diezmos y Ofrendas: Tu corazón generoso aporta al cumplimiento de la Gran Comisión junto a nosotros. Cada semilla es una inversión clave para la transformación espiritual de nuestra nación.
                        </p>
                        <div class="flex items-center gap-4 text-orange-300 italic">
                            <i class="fas fa-heart text-2xl"></i>
                            <p class="text-xl">"Dios ama al dador alegre". 2 Corintios 9:7</p>
                        </div>
                    </div>
                    <div class="bank-details-glass">
                        <div class="flex flex-col items-center gap-1 mb-4">
                            <i class="fas fa-university text-2xl te xt-orange-400"></i>
                            <h3 class="text-sm text-center font-bold italic"> Iglesia de Jesucristo Venezuela</h3>
                            <h4 class="text-sm  italic">Escanea el código!</h4>    
                        </div>
                        <div class="space-y-5">
                            <div class="w-full">
                                <img src="qr-bnc.jpg" alt="Qr Code" class="w-44 mx-auto rounded-md">
                            </div>
                            <div class="flex items-center gap-4 justify-center">
                                <img src="bnc-logo.png" alt="bnc logo" class="w-10 ">
                                <div class="flex flex-col justify-center align-middle border-l border-white/20 pl-2">
            
                                    <p class="text-xs tracking-tight uppercase opacity-60">Banco Nacional de Credito</p>
                                    <p class="text-md font-medium ">Nuestro Pago Movil</p>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>


            


        
        <!-- Sección Video + Mensaje -->
        <section class="py-18 px-6 bg-orange-50/50">
            <div class="max-w-5xl mx-auto flex flex-col md:grid md:grid-cols-2 gap-12 items-center">

                <!-- Mensaje izquierda -->
                <div class="space-y-6 w-full">
                    <span class="text-xs font-bold text-orange-600 bg-orange-100 px-4 py-2 rounded-full uppercase tracking-widest">
                        Síguenos en redes
                    </span>
                    <h2 class="text-3xl md:text-4xl font-bold text-orange-900 italic leading-tight mt-3">
                        "Llevamos la Palabra a donde estés"
                    </h2>
                    <p class="text-lg text-gray-700 leading-relaxed max-w-prose">
                        Cada semana publicamos mensajes cortos llenos de fe en nuestras redes sociales. Síguenos y recibe una palabra de aliento directo en tu feed.
                    </p>
                    <div class="flex flex-col gap-3">
                        <a href="https://www.instagram.com/iglesiadejesucristovzla/" target="_blank" class="inline-flex items-center gap-3 text-pink-600 font-bold text-lg hover:text-pink-500 transition">
                            <i class="fab fa-instagram text-2xl"></i>
                            Síguenos en Instagram
                        </a>
                                                <a href="https://www.facebook.com/iglesiadejesucristovzla" target="_blank" class="inline-flex items-center gap-3 text-blue-600 font-bold text-lg hover:text-blue-500 transition">
                            <i class="fab fa-facebook text-2xl"></i>
                            Síguenos en Facebook
                        </a>
                        <a href="https://wa.me/+584121126733" target="_blank" class="inline-flex items-center gap-3 text-green-600 font-bold text-lg hover:text-green-500 transition">
                            <i class="fab fa-whatsapp text-2xl"></i>
                            Contáctanos por WhatsApp
                        </a>

                    </div>
                </div>

                <!-- Video YouTube Short derecha -->
                <div class="perspective-container w-full">
                    <div class="grabacion2 rounded-3xl shadow-2xl border-4 border-zinc-950">
                        <div class="cara2 superior2"></div>
                        <div class="cara2 inferior2"></div>
                        <div class="cara2 derecha2"></div>
                        <div class="camara2"><p>o</p></div>
                        <iframe
                            src="https://www.youtube.com/embed/XVkXyYWhycg"
                            class="w-full aspect-9/16 rounded-2xl" 
                            frameborder="0"
                            allowfullscreen>
                        </iframe>
                    </div>
                </div>

            </div>
        </section>



    </main>


<style>


/* Contenedor de perspectiva */
.perspective-container {
    perspective: 1200px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 10px 30px 0px;
}

.perspective-container::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 16px;
    width: 280px;
    height: 22px;
    transform: translateX(-50%) rotateX(90deg) rotatey(13deg) rotateZ(-12deg);
    background: rgba(0, 0, 0, 0.18);
    filter: blur(14px);
    border-radius: 50%;
    z-index: 0;
}

/* El cuerpo del celular */
.grabacion2 {
    z-index: 10;
    position: relative;
    width: 320px;
    /* Mantenemos la rotación para ver el efecto 3D */
    transform: rotateX(-10deg) rotateY(-20deg);
    transform-style: preserve-3d;
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.18);
}

/* Base común para todas las caras laterales */
.cara2 {
    position: absolute;
    background: #1a1a1a; /* Color oscuro para profundidad */
    border: 1px solid #000;
}

/* Cara Superior: Se dobla desde el borde de arriba */
.superior2 {
    width: 100%;
    height: 40px; /* Grosor del celular */
    top: -2px;
    left: 0;
    transform-origin: top;
    transform: rotateX(-70deg);
    background: #272727;
    border-radius: 1em 1em 0 0; /* Solo arriba para que encaje con el frente */
}

/* Cara Inferior: Se dobla desde el borde de abajo */
.inferior2 {
    width: 100%;
    height: 40px; /* Grosor del celular */
    bottom: 0;
    left: 0;
    transform-origin: bottom;
    transform: rotateX(90deg);
    background: #121212;
    border-radius: 0 0 1em 1em; /* Solo abajo */
}

/* Cara Derecha: Se dobla desde el borde derecho */
.derecha2 {
    width: 40px; /* Grosor del celular */
    height: 99%;
    top: 4px;
    right: 0;
    transform-origin: right;
    transform: rotateY(-90deg);
    background: #222;
    border-radius: 2em 1em 3em 0; /* Solo en el lado externo derecho */
}

/* La cámara (Dynamic Anchor) */
.camara2 {
    width: 60px;
    height: 20px;
    background: #000;
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 0 0 15px 15px;
    z-index: 30;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #333;
}






            /* Sección de Diezmos y Ofrendas */
        .giving-banner {
            background: linear-gradient(rgba(140, 75, 29, 0.9), rgba(61, 43, 31, 0.9)), url('https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&fit=crop&q=80&w=1400');
            background-size: cover;
            background-position: center;
            border-radius: 50px;
            color: white;
        }
        

        .bank-details-glass {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 30px;
            padding: 26px;
        }
      /*       background: linear-gradient(135deg, #a65d26 0%, #633314 100%); */
        
      /*       background: linear-gradient(135deg, #a65d26 0%, #633314 100%), url('logo--blanco.png'); */

.bg-church-gradient {
    position: relative; /* Necesario para contener la capa del logo */
    width: 100%;
    background: linear-gradient(135deg, rgba(166, 93, 38, 0.45) 0%, rgba(99, 51, 20, 0.55) 100%);
    overflow: hidden;
}

.bg-church-gradient h1,
.bg-church-gradient p,
.bg-church-gradient a {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5), 0 1px 4px rgba(0, 0, 0, 0.3);
}

.bg-church-gradient::before {
content: "";
    position: absolute;
    top: -15%; left: 0; right: -5%; bottom: 0;
    
    /* 1. Ponemos la imagen Y el mismo degradado (o un color base) */
    background-image: url('casa-horizontal.jpg'), 
                      linear-gradient(135deg, rgba(166, 93, 38, 0.45) 0%, rgba(99, 51, 20, 0.55) 100%);
    
    background-size: 100%, cover;
    background-repeat: no-repeat;
    background-position: top center, center;

    /* 2. LA MAGIA: Esto mezcla la imagen con el degradado del paso 1 */
    background-blend-mode: soft-light; /* Prueba también con 'multiply' o 'luminosity' */
    
    /* 3. Ajuste fino de presencia */
    opacity: 0.55;
}

@media (max-width: 600px) {
.bg-church-gradient::before {
content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    
    /* 1. Ponemos la imagen Y el mismo degradado (o un color base) */
    background-image: url('casa.jpg'), 
                      linear-gradient(135deg, rgba(166, 93, 38, 0.45) 0%, rgba(99, 51, 20, 0.55) 100%);
    
    background-size: 100%, cover;
    background-repeat: no-repeat;
    background-position: center center, center;

    /* 2. LA MAGIA: Esto mezcla la imagen con el degradado del paso 1 */
    background-blend-mode: soft-light;
    
    /* 3. Ajuste fino de presencia */
    opacity: 0.55;
}
}

/* Luz superior / rayos sutiles para efecto espiritual */
.bg-church-gradient::after {
        content: "";
        position: absolute;
        top: -18%;
        left: 50%;
        transform: translateX(-50%);
        width: 140%;
        height: 70%;
        pointer-events: none;
        z-index: 5;
        /* Capa de halo + rayos: radial + conic for subtle beams */
        background-image:
            radial-gradient(ellipse at top center, rgba(255, 240, 180, 0.22), rgba(255,240,200,0.08) 25%, transparent 45%),
            repeating-conic-gradient(from 270deg at 50% 0%, rgba(255,245,200,0.06) 0deg 2deg, rgba(255,245,200,0.00) 2deg 6deg);
        background-blend-mode: screen;
        filter: blur(10px);
        opacity: 0.9;
        mix-blend-mode: screen;
        transform-origin: top center;
        animation: subtle-sun-move 6s ease-in-out infinite alternate;
}

@keyframes subtle-sun-move {
        from { transform: translateX(-50%) translateY(-2px) scale(1); opacity: 0.88; }
        to   { transform: translateX(-48%) translateY(2px) scale(1.02); opacity: 0.98; }
}

@media (max-width: 600px) {
    .bg-church-gradient::after {
        top: -10%;
        width: 200%;
        height: 50%;
        background-image: radial-gradient(ellipse at top center, rgba(255, 240, 180, 0.18), rgba(255,240,200,0.06) 30%, transparent 55%);
        filter: blur(12px);
        animation-duration: 8s;
    }
}


    </style>
   

<script>
/**
