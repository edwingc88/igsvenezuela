     <div class="flex justify-center relative  px-4 perspective-[1150px]">
            <!-- Contenedor del video con ancho controlado y bordes redondeados -->
            <div class="grabacion rounded-3xl overflow-hidden shadow-2xl border-4 border-zinc-950 w-full max-w-[320px]">
                <div class="camara"><p>o</p></div>
                <iframe
                    src="https://www.youtube.com/embed/XVkXyYWhycg"
