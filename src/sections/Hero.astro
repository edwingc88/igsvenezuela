                    class="w-full aspect-9/16" 
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen>
                </iframe>

            </div>
                <div class="cara superior"></div>
            <div class="cara inferior"></div>
                    <div class="cara derecha"></div>
                        
        </div>
 * 
 **/
</script>   