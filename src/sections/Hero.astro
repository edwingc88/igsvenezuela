    <!-- PÁGINA: INICIO -->
    <main id="page-inicio" class="page-content">
        <!-- Hero Section -->
        <header class="relative overflow-hidden bg-church-gradient text-white py-24 px-6 text-center">
            <div class="max-w-4xl mx-auto relative z-10">
                <h1 class="text-4xl md:text-6xl font-bold mb-6 italic">Te esperamos con los brazos abiertos</h1>
                <p class="text-lg md:text-xl opacity-90 mb-10 leading-relaxed">
                    Somos una familia en Venezuela que camina en fe. Si buscas un lugar donde congregarte, necesitas oración o simplemente quieres conocernos, este es tu hogar.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <button onclick="showPage('contacto')" class="bg-white text-orange-900 px-8 py-4 rounded-xl font-bold shadow-xl hover:bg-orange-50 transition transform hover:scale-105">
                        <i class="fas fa-hands-helping mr-2"></i> Quiero que oren por mí / Visitar
                    </button>
                    <button onclick="showPage('servicios')" class="bg-orange-700/30 backdrop-blur-md border border-white/30 text-white px-8 py-4 rounded-xl font-bold hover:bg-orange-700/50 transition">
                        Ver horarios de Cultos
                    </button>
                </div>
            </div>
        </header>
        <!-- Mensaje del Pastor / Invitación a la Salvación -->
        <section class="pastor-section py-12 px-6 border-y border-orange-100">
            <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
                <div class="relative">
                    <div class="absolute -top-4 -left-4 w-24 h-24 bg-orange-100 rounded-full -z-10"></div>
                    <img src="pastorBanderaVnz.jpg" class="rounded-3xl shadow-2xl border-4 border-white transform -rotate-2 hover:rotate-0 transition duration-500">
                    <div class="absolute bottom-6 right-6 bg-white px-6 py-2 rounded-full shadow-lg border border-orange-50">
                        <p class="text-orange-900 font-bold italic">Pastor Principal</p>
                    </div>
                </div>
                <div class="space-y-6">
                    <h2 class="text-3xl md:text-4xl font-bold text-orange-900 italic">"Hay un lugar para ti en la mesa del Señor"</h2>
                    <p class="text-lg text-gray-700 leading-relaxed">
                        Querido amigo, no importa por lo que estés pasando o cuán lejos te sientas de Dios, hoy Su amor te busca. Cristo no solo quiere ser tu religión, Él quiere ser tu Salvador, tu paz y tu esperanza firme.
                    </p>
                    <p class="text-lg text-gray-700 leading-relaxed">
                        Venezuela es tierra de bendición, y tú eres parte fundamental de ese propósito. Te invito a que hoy des el paso más importante de tu vida: abrirle tu corazón al Rey de Reyes.
                    </p>
                    <div class="pt-4">
                        <button onclick="showPage('contacto')" class="inline-flex items-center space-x-3 text-orange-800 font-bold text-xl hover:text-orange-600 transition">
                            <span>¿Hablamos? Queremos orar contigo</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>
        <!-- Formulario de Galería de Fotos -->
        <section id="seccion-subir" class="py-20 px-6">
            <div class="max-w-3xl mx-auto">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold text-orange-900 mb-4 uppercase tracking-wider">Muro de Recuerdos</h2>
                    <p class="text-gray-600 italic">Comparte una galería de fotos de nuestros momentos especiales juntos.</p>
                </div>

                <div class="bg-white p-8 md:p-10 rounded-3xl card-shadow border border-orange-50">
                    <form id="churchForm" class="space-y-6">
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-bold text-orange-900 mb-2" for="nombre">Publicado por:</label>
                                <input type="text" id="nombre" placeholder="Tu nombre o familia" 
                                    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-orange-500 outline-none transition" required>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-orange-900 mb-2" for="categoria">Categoría</label>
                                <select id="categoria" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-orange-500 outline-none transition bg-white">
                                    <option value="General">General</option>
                                    <option value="Cultos">Cultos Dominicales</option>
                                    <option value="Social">Obra Social</option>
                                    <option value="Jovenes">Ministerio Juvenil</option>
                                    <option value="Ninos">Escuela Dominical</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-orange-900 mb-2" for="titulo">Título de la Galería</label>
                            <input type="text" id="titulo" placeholder="Ej: Fotos del Bautizo" 
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-orange-500 outline-none transition" required>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-orange-900 mb-2">Selecciona tus fotos (pueden ser varias)</label>
                            <div id="drop-area" class="drop-zone relative rounded-2xl flex flex-col items-center justify-center cursor-pointer overflow-hidden bg-gray-50">
                                <input type="file" id="foto" class="hidden" accept="image/*" multiple>
                                
                                <div id="preview-container" class="preview-grid hidden">
                                    <!-- Aquí se cargarán las miniaturas -->
                                </div>

                                <div id="empty-preview" class="text-center py-10">
                                    <i class="fas fa-images text-5xl text-orange-200 mb-4"></i>
                                    <p class="text-gray-400 font-medium px-4">Haz clic para elegir una o varias fotos</p>
                                </div>
                                
                                <button id="remove-img" type="button" class="hidden absolute top-3 right-3 bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center shadow-lg z-20">
                                    <i class="fas fa-trash-alt text-xs"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="w-full btn-church text-white font-bold py-4 rounded-xl shadow-lg flex items-center justify-center space-x-2">
                            <span>Publicar Galería en el Muro</span>
                            <i class="fas fa-th"></i>
                        </button>
                    </form>
                </div>
            </div>
        </section>


    </main>



   

